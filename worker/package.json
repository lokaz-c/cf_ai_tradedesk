{
  "name": "cf-ai-tradedesk-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && wrangler dev",
    "dev:no-ai": "npm run db:migrate && wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply tradedesk-db --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "db:explain": "node scripts/explain-query-plan.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  }
}
